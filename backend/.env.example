# Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is in .gitignore.

# MongoDB connection string
# For local dev with Docker: mongodb://localhost:27017/deal-aggregator
# For Docker Compose (Phase 3): mongodb://mongo:27017/deal-aggregator
MONGO_URI=mongodb://localhost:27017/deal-aggregator

# Port the Express server listens on
PORT=5000

# Allowed CORS origin (your frontend URL)
CLIENT_ORIGIN=http://localhost:5173
