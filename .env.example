# ─── Deal Aggregator: Local Docker Compose Variables ─────────────────────────
# Copy to .env (git-ignored) before running `docker compose up`.
# Use URL-safe passwords — they are embedded in the MongoDB connection string.

# MongoDB root credentials (applied only when the mongo-data volume is empty)
MONGO_USERNAME=dealadmin
MONGO_PASSWORD=localdevpassword

# Grafana admin password (falls back to "admin" in dev if unset)
GRAFANA_PASSWORD=admin
