# ─── Deal Aggregator: Production Environment Variables ───────────────────────
# Copy this file to .env on the EC2 server (next to docker-compose.prod.yml)
# and set real values. NEVER commit a filled-in .env to Git.
#
# docker compose refuses to start if any required value below is missing.
# Use URL-safe passwords (they are embedded in the MongoDB connection string):
#   openssl rand -hex 24

# MongoDB root credentials (applied only when the mongo-data volume is empty)
MONGO_USERNAME=dealadmin
MONGO_PASSWORD=change-me

# Grafana admin password (required — no default)
GRAFANA_PASSWORD=change-me
