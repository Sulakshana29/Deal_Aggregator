# Scraper Environment Variables
# Copy this file to .env — never commit the real .env (it is in .gitignore)

# MongoDB connection string
# Local dev (Docker):   mongodb://localhost:27017/deal-aggregator
# Docker Compose:       mongodb://mongo:27017/deal-aggregator
# K8s (Phase 4):        loaded from Kubernetes Secret
MONGO_URI=mongodb://localhost:27017/deal-aggregator

# Target URL to scrape (mypromo.lk — server-rendered, no login required)
SCRAPE_URL=https://mypromo.lk/promotions/supermarkets

# How many ms to wait between retries on network failure
RETRY_DELAY_MS=3000
