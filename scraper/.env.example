# Scraper Environment Variables
# Copy this file to .env — never commit the real .env (it is in .gitignore)

# MongoDB connection string
# Bare-metal dev against the compose MongoDB (auth enabled, creds from root .env):
#   mongodb://<user>:<pass>@localhost:27017/deal-aggregator?authSource=admin
# Docker Compose / K8s inject MONGO_URI themselves — no .env needed there.
MONGO_URI=mongodb://dealadmin:localdevpassword@localhost:27017/deal-aggregator?authSource=admin

# Target URL to scrape (mypromo.lk — server-rendered, no login required)
SCRAPE_URL=https://mypromo.lk/promotions/supermarkets

# How many ms to wait between retries on network failure
RETRY_DELAY_MS=3000
